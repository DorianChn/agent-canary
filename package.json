{
  "name": "@dorianchn/agent-canary",
  "version": "1.2.7",
  "description": "Free AI-agent tripwires with a guarded tool router, offline containment self-tests, and redacted audit events.",
  "license": "MIT",
  "author": "DorianChn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DorianChn/shanchuanzhi-agent-canary.git"
  },
  "homepage": "https://github.com/DorianChn/shanchuanzhi-agent-canary#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": "https://github.com/DorianChn/shanchuanzhi-agent-canary/issues",
  "keywords": [
    "mcp",
    "security",
    "prompt-injection",
    "canary",
    "honeypot",
    "ai-agents",
    "llm",
    "agent-security",
    "devtools"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-canary": "dist/index.js"
  },
  "exports": {
    "./sdk": "./dist/sdk.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
