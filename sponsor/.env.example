# ---- V2 paid release access ----
# V1 remains free. Set this to 1 only on the gateway that is intentionally
# configured to sell V2 Personal licenses. The legacy COOPERATION_ORDERS=1
# name remains accepted as a migration alias.
V2_PAID_ORDERS=0

# ---- live-sale checklist (keep secrets out of git) ----
# DEMO=0
# V2_PAID_ORDERS=1
# PUBLIC_BASE_URL=https://pay.example.com
# LICENSE_PRIVATE_KEY_PATH=/absolute/path/to/license-signing-key.pem
# Configure at least one payment channel below, then run the smoke test and a
# small end-to-end payment before advertising the gateway.

# ---- plans ----
# V2 Personal pricing (server-authoritative; change before live sales)
PERSONAL_USD=10
PERSONAL_CNY=72

# ---- V免签【零成本·全自动·自托管，配安卓监控端】 ----
# 部署 szvone/vmqphp 后，填你的 vmq 域名和后台"系统设置"里的通讯密钥：
#VMQ_URL=https://你的vmq域名
#VMQ_KEY=通讯密钥
# Public URL of the Vmq payment page seen by payers. If omitted, VMQ_URL is used.
#VMQ_PUBLIC_URL=https://你的公网vmq域名

# ---- 易支付(Epay)协议聚合平台【个人免商户·最简单】 ----
# 三项填齐即自动启用（优先级高于下方官方商户通道）。
# 平台示例：ZPAY(z-pay.cn)、七相PAY(qixiangpay.cn) 等"易支付协议"平台。
# 开户需手机号+实名，付一次性开户费（88~148元），后台拿到 商户PID 和 商户密钥 填入：
#EPAY_API_URL=https://zpayz.cn
#EPAY_PID=
#EPAY_KEY=

# ---- mode ----
# 1 = demo (no credentials needed, simulated payment). Use 0 only after the
# HTTPS callback URL, license key, and at least one payment channel are ready.
DEMO=1
PORT=8787
# Optional: keep runtime state outside the source checkout.
#DATA_DIR=/var/lib/agent-canary-sponsor
# Maximum active machines per authorized handle and signed-license lifetime.
LICENSE_MAX_MACHINES=3
LICENSE_TTL_DAYS=30
# Release major signed by this gateway. V2 builds require 2.
LICENSE_RELEASE_MAJOR=2
# Required for LIVE mode: private Ed25519 key matching the public key shipped in the CLI.
# Keep this outside git and back it up securely.
#LICENSE_PRIVATE_KEY_PATH=/absolute/path/to/license-signing-key.pem
# Public HTTPS base URL of this server (used for payment callbacks). Example: https://pay.example.com
PUBLIC_BASE_URL=http://localhost:8787

# ---- WeChat Pay (Native 扫码支付, API v3) ----
# 商户号
WECHAT_MCHID=
# 商户 API 证书序列号 (商户平台 → API安全 → 证书序列号)
WECHAT_SERIAL=
# 商户 appid (公众号/小程序/开放平台应用)
WECHAT_APPID=
# APIv3 密钥 (32 位, 商户平台 → API安全 → APIv3密钥)
WECHAT_APIV3_KEY=
# apiclient_key.pem 的路径 (商户 API 私钥)
WECHAT_PRIVATE_KEY_PATH=

# ---- Alipay (当面付 precreate) ----
ALIPAY_APP_ID=
# 应用私钥 PKCS8 PEM 路径 (开放平台 → 应用 → 接口加签方式)
ALIPAY_PRIVATE_KEY_PATH=
# 支付宝公钥 PEM 路径 (用于验签异步通知)
ALIPAY_PUBLIC_KEY_PATH=
# 可选：网关覆盖 (默认正式环境 https://openapi.alipay.com/gateway.do)
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
